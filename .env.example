# Copy to .env. NEVER commit real credentials or expose :8080 on the Internet.
DOMAIN=localhost
IMAGE=papergrade:local
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ADMIN_USERNAME=teacher
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
# Production must stay false; true is for localhost-only HTTP development.
DEV_MODE=false
# Only infrastructure secret: generate once with openssl rand -hex 32.
# Keep stable and back up separately; changing it makes stored provider keys unreadable.
APP_ENCRYPTION_KEY=
# Configure models in the admin "模型与接口" page; save applies without restart.
# The following are optional legacy bootstrap values only, used before first UI save.
# OCR supports native Ollama in the admin UI (address/model empty by default).
# Legacy env OCR/card values remain custom gateway contracts. New a5-v2 uses built-in OMR.
# OCR gateway accepts raw PDF POST -> {"text":"...","pages":1}.
OCR_ENDPOINT=
OCR_API_KEY=
# OpenAI-compatible Chat Completions base URL, usually ending /v1.
# Do NOT include /chat/completions. Needs JSON object/temperature/max_tokens support.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Separate cloud OMR/card gateway; must implement docs/CLOUD_PROVIDERS.md.
CARD_ENDPOINT=
CARD_API_KEY=
LOCAL_OMR_ENABLED=false
