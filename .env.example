# 复制为 .env。生产环境不要提交真实凭据。
DOMAIN=localhost
IMAGE=papergrade:local
ADMIN_USERNAME=teacher
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
DEV_MODE=false
# 唯一必须长期保存的密钥：openssl rand -hex 32
# 换掉它会让后台已保存的模型密钥全部无法解密。
APP_ENCRYPTION_KEY=
# 数据库是容器内 /app/data/papergrade.db 单文件（SQLite），不需要数据库服务。
# 模型地址与密钥在后台「模型与服务设置」里配置，不写在这里。
