{$DOMAIN:localhost} {
 encode zstd gzip
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy same-origin
  Permissions-Policy "camera=(self), microphone=(), geolocation=()"
  -Server
 }
 @api path /api/* /healthz /readyz
 handle @api {
  reverse_proxy api:8080
 }
 handle {
  root * /srv
  try_files {path} /index.html
  file_server
 }
}
